# Copy to .env and fill in: cp .env.example .env
# M-Pesa Daraja API credentials (from https://developer.safaricom.co.ke -> My Apps)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Business shortcode: PayBill or Till number, e.g. 174379
MPESA_SHORTCODE=

# Lipa Na M-Pesa Online Pass Key
MPESA_PASSKEY=

# Environment: sandbox | live
MPESA_ENVIRONMENT=sandbox

# HTTPS URL where Daraja sends the STK push result
MPESA_CALLBACK_URL=

# Sandbox test phone (254 + 9 digits, e.g. 254708374149)
MPESA_TEST_PHONE=